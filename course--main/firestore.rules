rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // التطبيق يستخدم Anonymous Auth + رمز فتح داخل الواجهة.
    // مناسب لاستخدام المدرب على أجهزته. لا تنشر الرابط للعامة بدون حساب خاص لاحقاً.
    match /shared/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
